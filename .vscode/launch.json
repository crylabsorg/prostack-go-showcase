{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch user",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/apps/user",
      "cwd": "${workspaceFolder}/apps/user"
    },
    {
      "name": "Launch gateway",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/apps/gateway",
      "cwd": "${workspaceFolder}/apps/gateway"
    }
  ],
  "compounds": [
    {
      "name": "Launch all services",
      "configurations": ["Launch user", "Launch gateway"],
      "stopAll": true
    }
  ]
}
